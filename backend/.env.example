# ---------------------------------------------------------------------------
# Backend environment variables - COPY TO .env AND REPLACE ALL PLACEHOLDERS
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# MySQL connection string for the self-managed EC2 instance.
# URL-encode special characters in the password (for example @ -> %40).
MYSQL_URL=mysql://appuser:REPLACE_WITH_APPUSER_PASSWORD@REPLACE_WITH_EC2_HOST:3306/REPLACE_WITH_DB_NAME

# PEM CA certificate used to verify the database server certificate.
# Keep the literal \n escapes if the value is on a single line.
MYSQL_CA_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_DATABASE_CA_CERTIFICATE\n-----END CERTIFICATE-----"

# Long random secret (>= 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Allowed frontend origin(s). Comma-separated for multiple.
# Optional in the combined Vercel services project because the frontend and API
# share one origin. Set it if you call the API from a different origin.
FRONTEND_URL=https://your-project.vercel.app

# --- Optional -------------------------------------------------------------
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=2h
# Use "disable" for a local MySQL without TLS. Do not disable in production.
MYSQL_SSL=require
# Maximum pool connections (1-3 recommended for serverless).
MYSQL_POOL_MAX=3

# ---------------------------------------------------------------------------
# Backend environment variables - COPY TO .env AND REPLACE ALL PLACEHOLDERS
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the self-managed EC2 instance.
DATABASE_URL=postgresql://appuser:REPLACE_WITH_APPUSER_PASSWORD@REPLACE_WITH_EC2_HOST:5432/REPLACE_WITH_DB_NAME

# PEM CA certificate used to verify the database server certificate.
# Keep the literal \n escapes if the value is on a single line.
DB_CA_CERT="-----BEGIN CERTIFICATE-----\nREPLACE_WITH_DATABASE_CA_CERTIFICATE\n-----END CERTIFICATE-----"

# Long random secret (>= 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Allowed frontend origin(s). Comma-separated for multiple.
FRONTEND_URL=https://your-frontend.vercel.app

# --- Optional -------------------------------------------------------------
NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=2h
# Use "disable" for a local PostgreSQL without TLS. Do not disable in production.
PGSSLMODE=require
# Maximum pool connections (1-3 recommended for serverless).
PG_POOL_MAX=3

# ---------------------------------------------------------------------------
# Backend environment variables - COPY TO .env AND ADJUST
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# Typical local MySQL connection.
# If your MySQL user has a password, set it in DB_PASSWORD.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dbuild

# Use "disable" for a local MySQL without TLS. Do not disable in production.
MYSQL_SSL=disable
# Optional: path to a CA file or PEM contents when TLS verification is enabled.
# MYSQL_CA_CERT=
# Maximum pool connections (1-3 recommended for serverless).
MYSQL_POOL_MAX=3

# Optional: full connection string. Overrides DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# MYSQL_URL=mysql://appuser:password@localhost:3306/dbuild

# Demo seed defaults are tracked in backend/config/demo.js.
# Set these only when you want to override the tracked demo passwords.
# DEMO_STUDENT_PASSWORD=
# DEMO_FACULTY_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# Optional: use a DDL-capable account for schema migrations.
# Defaults to DB_USER/DB_PASSWORD when not set. Never use appuser for migrations.
# DB_MIGRATION_USER=
# DB_MIGRATION_PASSWORD=

# Required for local demo data only. Production seeding is blocked unless enabled.
# ALLOW_DEMO_SEED=true

# Long random secret (>= 32 chars). Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Allowed frontend origin(s). Comma-separated for multiple.
FRONTEND_URL=http://localhost:5173

NODE_ENV=development
PORT=5000
JWT_EXPIRES_IN=2h

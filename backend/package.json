{
  "name": "college-portal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "College Management Portal API (Express, serverless on Vercel)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "check": "node --check api/index.js && node --check server.js",
    "test-db": "node scripts/test-db-connection.js",
    "db:migrate": "node scripts/migrate.js",
    "db:update": "npm run db:migrate && npm run seed-demo",
    "create-admin": "node scripts/create-admin.js",
    "create-student": "node scripts/create-student.js",
    "seed-demo": "node scripts/seed-demo-data.js",
    "verify-demo": "node scripts/verify-demo-auth.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0"
  }
}
